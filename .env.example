# Bhumi Vikas Sahayak (भूमि विकास सहायक) - Frontend Environment Variables
# MP Building Regulations AI Assistant

# Base URL of the backend RAG server (e.g., http://localhost:8000 or http://127.0.0.1:5000)
# Leave empty or set to / to use relative /api/chat path
VITE_API_BASE_URL=http://localhost:8000

# Set to true to force local mock mode when testing frontend without running backend
# Default: false (will attempt backend first, with graceful fallback notice)
VITE_USE_MOCK=false
