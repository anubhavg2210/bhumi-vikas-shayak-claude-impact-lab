# Bhumi Vikas Sahayak (भूमि विकास सहायक) - Frontend Environment Variables
# Copy to .env.local (git-ignored). Only VITE_* variables reach the browser bundle,
# so never put API keys here. Backend settings and secrets live in backend/.env.

# Base URL of the backend. Leave EMPTY in development: requests go to /api/chat and
# /health on the Vite dev server, which proxies them to BACKEND_URL (no CORS needed).
# Set it only when the frontend is served separately from the backend, e.g. https://api.example.org
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api and /health (dev server only, not bundled)
BACKEND_URL=http://127.0.0.1:8000

# true = start in mock mode. Mock answers are demo content, not verified rules,
# and are always labelled as such. The app never falls back to mock data on its own.
VITE_USE_MOCK=false

# Request timeout in ms (keep above the backend's LLM timeout)
VITE_API_TIMEOUT_MS=90000
