# Copy to backend/.env (git-ignored) and fill in values. Never commit real keys.
# Real environment variables override values in this file.

# ---- Server -------------------------------------------------------------
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
# Frontend dev origins allowed by CORS (comma-separated or JSON array). No wildcard by default.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---- Document collection ------------------------------------------------
DOCUMENT_COVERAGE_DATE=2025-03-06
DATA_DIR=data

# ---- LLM provider -------------------------------------------------------
# cerebras   : Cerebras Cloud (needs CEREBRAS_API_KEY)
# extractive : no LLM; returns verified source passages only (works without any key)
# anthropic | openai | gemini : other supported providers
LLM_PROVIDER=cerebras
# Per-request timeout in seconds (the SDK may retry, see CEREBRAS_MAX_RETRIES)
LLM_TIMEOUT_SECONDS=60

# ---- Cerebras Cloud -----------------------------------------------------
# Create a key at https://cloud.cerebras.ai (API Keys). Keep it server-side only:
# never put it in a VITE_/REACT_APP_ variable or any frontend file.
CEREBRAS_API_KEY=
# Model ID available to your account; empty = gpt-oss-120b. List yours with:
#   python -m backend.app.tools.check_cerebras
CEREBRAS_MODEL=
# Optional tuning (empty = model default)
CEREBRAS_REASONING_EFFORT=
CEREBRAS_TEMPERATURE=
CEREBRAS_MAX_COMPLETION_TOKENS=4096
CEREBRAS_MAX_RETRIES=2

# ---- Other providers (optional) -----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_ENABLE_FALLBACKS=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Retrieval tuning ---------------------------------------------------
MAX_RETRIEVAL_CHUNKS=5
MIN_SIMILARITY_THRESHOLD=0.15
