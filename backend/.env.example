# Copy to backend/.env (git-ignored) and fill in values. Never commit real keys.
# Real environment variables override values in this file.

# ---- Server -------------------------------------------------------------
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
# Frontend dev origins allowed by CORS (comma-separated or JSON array). No wildcard by default.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# Regex pattern for allowed origins (e.g. Vercel preview/production deployments)
CORS_ORIGIN_REGEX=^https:\/\/([a-zA-Z0-9-]+\.)*vercel\.app$

# ---- Document collection ------------------------------------------------
DOCUMENT_COVERAGE_DATE=2025-03-06
DATA_DIR=data

# ---- LLM provider -------------------------------------------------------
# cerebras   : Cerebras Cloud (needs CEREBRAS_API_KEY)
# extractive : no LLM; returns verified source passages only (works without any key)
# anthropic | openai | gemini : other supported providers
LLM_PROVIDER=cerebras
# Per-request timeout in seconds (the SDK may retry, see CEREBRAS_MAX_RETRIES)
LLM_TIMEOUT_SECONDS=60

# ---- Cerebras Cloud -----------------------------------------------------
# Create a key at https://cloud.cerebras.ai (API Keys). Keep it server-side only:
# never put it in a VITE_/REACT_APP_ variable or any frontend file.
CEREBRAS_API_KEY=
# Model ID available to your account; empty = gpt-oss-120b. List yours with:
#   python -m backend.app.tools.check_cerebras
CEREBRAS_MODEL=
# Optional tuning (empty = model default)
CEREBRAS_REASONING_EFFORT=
CEREBRAS_TEMPERATURE=
CEREBRAS_MAX_COMPLETION_TOKENS=4096
CEREBRAS_TIMEOUT_SECONDS=20
CEREBRAS_MAX_RETRIES=2
# Retry a 429/5xx only if Cerebras asks to wait at most this long; otherwise answer
# immediately with the "usage limit reached, try again" fallback.
CEREBRAS_MAX_RETRY_WAIT_SECONDS=5

# ---- Uploaded documents (POST /api/documents/analyze) -------------------
# Files are read in memory and never stored. OCR for photos/scanned PDFs uses Cerebras vision.
OCR_ENGINE=auto
CEREBRAS_VISION_MODEL=qwen-3.8-27b
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PAGES=30
# Each OCR page is one Cerebras request (free tier: 5 requests/minute).
UPLOAD_MAX_OCR_PAGES=3
UPLOAD_MAX_TEXT_CHARS=24000

# ---- Other providers (optional) -----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_ENABLE_FALLBACKS=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Retrieval tuning ---------------------------------------------------
MAX_RETRIEVAL_CHUNKS=8
MIN_SIMILARITY_THRESHOLD=0.15
