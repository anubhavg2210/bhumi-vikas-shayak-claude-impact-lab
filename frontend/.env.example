# Bhumi Vikas Sahayak Frontend Configuration
# Base URL of the backend RAG server (e.g., http://localhost:8000 or http://127.0.0.1:8000)
VITE_API_BASE_URL=http://localhost:8000

# Set to true to force offline mock mode during development without a backend running
# Default: false (will attempt backend first, with graceful fallback to mock if unreachable)
VITE_USE_MOCK=false
